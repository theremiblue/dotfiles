#!/usr/bin/env bash
set -euo pipefail

print_cpu() {
  awk '
    NR == 1 {
      total = 0
      for (i = 2; i <= NF; i++) {
        total += $i
      }

      idle = $5 + $6
      print "cpu", total, idle
      exit
    }
  ' /proc/stat
}

print_memory() {
  awk '
    /^MemTotal:/ {
      total = $2
    }

    /^MemAvailable:/ {
      available = $2
    }

    END {
      print "mem", total, available
    }
  ' /proc/meminfo
}

print_network() {
  awk '
    NR > 2 {
      gsub(":", "", $1)

      if ($1 != "lo") {
        rx += $2
        tx += $10
      }
    }

    END {
      print "net", rx + 0, tx + 0
    }
  ' /proc/net/dev
}

print_disk() {
  df -P / | awk '
    NR == 2 {
      gsub("%", "", $5)
      print "disk", $5, $3, $2
    }
  '
}

print_cpu
print_memory
print_network
print_disk
