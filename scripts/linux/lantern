#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: lantern [toggle|show|hide|refresh]

Control the Quickshell Lantern launcher.
EOF
}

action="${1:-toggle}"

case "$action" in
  toggle|show|hide|refresh)
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

case "$action" in
  show) ipc_action="reveal" ;;
  hide) ipc_action="dismiss" ;;
  *) ipc_action="$action" ;;
esac

quickshell ipc --any-display call lantern "$ipc_action"
