[
    {
        "context": "vim_mode == normal && !menu",
        "bindings": {
            "space w": "workspace::Save",
            "space e": "project_panel::ToggleFocus",
            "space g": "git_panel::ToggleFocus",
            "space t": "terminal_panel::ToggleFocus",
            "space a": "agent::ToggleFocus",
            "space s h": "editor::SwitchSourceHeader",
            "enter": "vim::HelixJumpToWord",
            "space y": ["workspace::SendKeystrokes", "\" + y"],
            "space shift-y": ["workspace::SendKeystrokes", "\" + shift-y"],
            "space p": ["workspace::SendKeystrokes", "\" + p"],
            "space shift-p": ["workspace::SendKeystrokes", "\" + shift-p"],
            "space d": ["workspace::SendKeystrokes", "\" _ d"],
            "space shift-d": ["workspace::SendKeystrokes", "\" _ shift-d"],
            ", p": ["workspace::SendKeystrokes", "\" 0 p"],
            ", shift-p": ["workspace::SendKeystrokes", "\" 0 shift-p"]
        }
    },
    {
        "context": "vim_mode == visual && !menu",
        "bindings": {
            "shift-j": "editor::MoveLineDown",
            "shift-k": "editor::MoveLineUp",
            "enter": "vim::HelixJumpToWord",
            "space y": ["workspace::SendKeystrokes", "\" + y"],
            "space p": ["workspace::SendKeystrokes", "\" + p"],
            "space shift-p": ["workspace::SendKeystrokes", "\" + shift-p"],
            "space d": ["workspace::SendKeystrokes", "\" _ d"],
            "space r p": ["workspace::SendKeystrokes", "\" _ d shift-p"]
        }
    },
    {
        "context": "(ProjectPanel || GitPanel || OutlinePanel || CollabPanel) && !editing",
        "bindings": {
            "space e": "project_panel::ToggleFocus",
            "space g": "git_panel::ToggleFocus",
            "space t": "terminal_panel::ToggleFocus",
            "space a": "agent::ToggleFocus",
            "q": "workspace::CloseActiveDock",
            "escape": "workspace::CloseActiveDock"
        }
    },
    {
        "bindings": {
            "cmd-1": "project_panel::ToggleFocus",
            "cmd-2": "git_panel::ToggleFocus",
            "cmd-3": "terminal_panel::ToggleFocus",
            "ctrl-`": "terminal_panel::ToggleFocus",
            "cmd-4": "agent::ToggleFocus",
            "cmd-b": "workspace::ToggleRightDock",
            "cmd-j": "workspace::ToggleBottomDock",
            "cmd-shift-w": "workspace::CloseActiveDock"
        }
    }
]
