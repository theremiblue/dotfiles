{
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "auto_update": false,

    "theme": "Base16 Tomorrow Night",
    "icon_theme": "Colored Zed Icons Theme Dark",
    "ui_font_family": "IBM Plex Mono",
    "ui_font_size": 16,
    "ui_font_features": {
        "liga": false,
        "calt": false,
        "dlig": false,
        "clig": false
    },
    "buffer_font_family": "IBM Plex Mono",
    "buffer_font_size": 16,
    "buffer_line_height": "comfortable",
    "buffer_font_features": {
        "liga": false,
        "calt": false,
        "dlig": false,
        "clig": false
    },
    "agent_ui_font_size": 16,
    "terminal": {
        "font_family": "IBM Plex Mono",
        "font_size": 16,
        "line_height": "comfortable",
        "font_features": {
            "liga": false,
            "calt": false,
            "dlig": false,
            "clig": false
        }
    },

    "close_panel_on_toggle": true,
    "project_panel": {
        "dock": "right",
        "default_width": 240,
        "indent_size": 24,
        "starts_open": false
    },
    "git_panel": {
        "dock": "right",
        "starts_open": false
    },
    "outline_panel": {
        "dock": "right",
        "starts_open": false
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "title_bar": {
        "show_onboarding_banner": false,
        "show_menus": false
    },
    "tab_bar": {
        "show": false
    },
    "diagnostics": {
        "button": false,
        "inline": {
            "enabled": true
        }
    },
    "search": {
        "button": false
    },

    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "never",
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": true
    },
    "relative_line_numbers": "enabled",
    "gutter": {
        "min_line_number_digits": 6
    },
    "line_indicator_format": "short",
    "preferred_line_length": 80,
    "soft_wrap": "none",
    "show_wrap_guides": false,
    "indent_guides": {
        "enabled": false
    },
    "scroll_beyond_last_line": "off",
    "vertical_scroll_margin": 16,
    "cursor_blink": false,
    "autosave": "off",
    "format_on_save": "on",
    "remove_trailing_whitespace_on_save": true,
    "use_on_type_format": false,
    "diff_view_style": "unified",

    "edit_predictions": {
        "allow_data_collection": "no",
        "provider": "zed",
        "mode": "subtle"
    },
    "agent": {
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^git\\s+ls-remote(\\s|$)"
                        },
                        {
                            "pattern": "^tail\\b"
                        },
                        {
                            "pattern": "^cmake\\b"
                        },
                        {
                            "pattern": "^find\\s+\\.build/cmake/_deps(\\s|$)"
                        },
                        {
                            "pattern": "^head\\b"
                        },
                        {
                            "pattern": "^grep\\b"
                        }
                    ]
                }
            }
        },
        "dock": "right",
        "use_modifier_to_send": true,
        "terminal_init_command": "agy",
        "default_profile": "write",
        "inline_assistant_model": {
            "provider": "google",
            "model": "gemini-3.5-flash"
        },
        "default_model": {
            "effort": "high",
            "provider": "openrouter",
            "model": "deepseek/deepseek-v4.1-flash-1017",
            "enable_thinking": true
        },
        "favorite_models": [
            {
                "provider": "ollama",
                "model": "qwen2.5-coder:7b",
                "enable_thinking": false
            },
            {
                "provider": "openrouter",
                "model": "~z-ai/glm-latest",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "openrouter",
                "model": "~anthropic/claude-opus-latest",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "openrouter",
                "model": "~openai/gpt-astra-latest",
                "enable_thinking": true,
                "effort": "medium"
            },
            {
                "provider": "openrouter",
                "model": "deepseek/deepseek-v4.1-flash-1017",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "openrouter",
                "model": "~z-ai/glm-flash-latest",
                "enable_thinking": true,
                "effort": "max"
            },
            {
                "provider": "openrouter",
                "model": "openai/gpt-6-luna",
                "enable_thinking": true,
                "effort": "medium"
            }
        ]
    },
    "agent_servers": {
        "antigravity-acp": {
            "default_config_options": {
                "mode": "auto_edit",
                "model": "gemini-4-argon"
            },
            "type": "registry"
        }
    },

    "lsp": {
        "clangd": {
            "binary": {
                "arguments": [
                    "--compile-commands-dir=_build",
                    "--background-index",
                    "--clang-tidy",
                    "--enable-config",
                    "--all-scopes-completion",
                    "--header-insertion=iwyu",
                    "--completion-style=bundled"
                ]
            }
        }
    },

    "languages": {
        "Python": {
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            }
        }
    }
}
