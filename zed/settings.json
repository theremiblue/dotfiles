// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // General
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "auto_update": false,
    "auto_install_extensions": {
        "assembly": true,
        "awk": true,
        "bash": true,
        "elixir": true,
        "glsl": true,
        "hlsl": true,
        "html": true,
        "java": true,
        "kotlin": true,
        "lua": true,
        "make": true,
        "neocmake": true,
        "nix": true,
        "objective-c": true,
        "perl": true,
        "php": true,
        "sql": true,
        "toml": true,
        "zig": true,
    },

    // UI & Appearance
    "theme": "Base16 Tomorrow Night",
    "icon_theme": "Colored Zed Icons Theme Dark",
    "title_bar": {
        "show_project_items": true,
        "show_branch_name": true,
        "show_onboarding_banner": false,
        "show_user_picture": true,
        "show_user_menu": true,
        "show_sign_in": true,
        "show_menus": false,
    },
    "project_panel": {
        "button": true,
        "default_width": 240,
        "indent_size": 24,
        "dock": "right",
        "starts_open": false,
    },
    "gutter": {
        "line_numbers": true,
        "min_line_number_digits": 6,
    },
    "line_indicator_format": "short",
    "pane_split_direction_horizontal": "down",
    "pane_split_direction_vertical": "right",
    "preview_tabs": {
        "enable_preview_from_project_panel": false,
        "enabled": false,
    },
    "max_tabs": 4,

    // Fonts
    "ui_font_family": "Inter",
    "ui_font_weight": 400,
    "ui_font_size": 16,
    "buffer_font_family": "0xProto NL",
    "buffer_font_size": 16,
    "buffer_font_weight": 400,
    "buffer_line_height": "comfortable",
    "buffer_font_features": {
        "liga": false,
        "calt": false,
        "dlig": false,
    },
    "terminal": {
        "font_family": "0xProto NL",
        "font_size": 16,
        "line_height": "comfortable",
    },
    "agent_ui_font_size": 16,

    // Editor
    "tabs": {
        "close_position": "left",
    },
    "autosave": "off",
    "current_line_highlight": "all",
    "format_on_save": "off",
    "hard_tabs": false,
    "line_ending": "prefer_lf",
    "relative_line_numbers": "enabled",
    "remove_trailing_whitespace_on_save": true,
    "scroll_beyond_last_line": "off",
    "show_whitespaces": "none",
    "show_wrap_guides": false,
    "soft_wrap": "none",
    "tab_size": 4,
    "use_on_type_format": false,
    "use_smartcase_search": true,
    "vertical_scroll_margin": 16,
    "cursor_blink": false,
    "cursor_shape": null,
    "indent_guides": {
        "enabled": false,
    },

    // Keymaps & Vim
    "base_keymap": "JetBrains",
    "vim_mode": true,
    "vim": {
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": true,
    },

    // AI & Agents
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
    },
    "agent": {
        "default_profile": "ask",
        "inline_assistant_model": {
            "provider": "google",
            "model": "gemini-3.5-flash",
        },
        "default_model": {
            "provider": "google",
            "model": "gemini-3.1-pro-preview",
            "enable_thinking": true,
            "effort": "high",
        },
        "thread_summary_model": {
            "provider": "google",
            "model": "gemini-3.5-flash",
        },
        "commit_message_model": {
            "provider": "google",
            "model": "gemini-3.5-flash",
        },
        "subagent_model": {
            "provider": "google",
            "model": "gemini-3.5-flash",
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "agent_servers": {
        "gemini": {
            "type": "registry",
        },
        "opencode": {
            "type": "registry",
        },
        "codex-acp": {
            "type": "registry",
        },
    },

    // Tools
    "diagnostics": {
        "button": false,
        "inline": {
            "enabled": false,
        },
    },
    "search": {
        "button": false,
        "case_sensitive": false,
        "center_on_match": true,
        "include_ignored": false,
        "regex": false,
        "whole_word": false,
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },

    // Languages
    "languages": {
        "C": {
            "format_on_save": "on",
        },
        "C++": {
            "format_on_save": "on",
        },
        "Python": {
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
        },
    },
}
