# Paths rely on setup.sh symlinking this dir to ~/.config/git/custom
[init]
    defaultBranch = main

[branch]
    sort = -committerdate

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[submodule]
    recurse = true

[include]
    path = ~/.config/git/custom/aliases.gitconfig
    path = ~/.config/git/custom/delta.gitconfig
    path = ~/.config/git/custom/tools.gitconfig
